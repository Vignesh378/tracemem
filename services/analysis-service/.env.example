NODE_ENV=development
PORT=5002
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/tracemem_analysis

# Use "s3" in production and configure AWS credentials/role and bucket below.
STORAGE_MODE=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

TEMP_DIR=./tmp
UPLOAD_DIR=./storage/uploads
MAX_EXAMPLES=30
MAX_FILE_SIZE_MB=512

# Set these relative to services/analysis-service for local npm scripts.
PYTHON_PATH=python
CORE_SCRIPT_PATH=../core-service/scripts/run_pipeline.py
CORE_WORKDIR=../core-service
